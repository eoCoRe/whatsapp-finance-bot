# E-mail da Service Account criada no Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=finance-bot@seu-projeto.iam.gserviceaccount.com

# Chave privada da Service Account (copie o conteúdo do arquivo JSON baixado)
# Mantenha as aspas e o \n literal
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAK...\n-----END RSA PRIVATE KEY-----\n"

# Nome da aba/sheet dentro da planilha
GOOGLE_SHEET_NAME=Gastos

# ==============================================
# WHATSAPP - NÚMEROS AUTORIZADOS
# ==============================================
# Apenas mensagens destes números serão processadas pelo bot
# Formato: código do país + DDD + número (sem espaços, traços ou +)
# Exemplo brasileiro: 5511999999999
